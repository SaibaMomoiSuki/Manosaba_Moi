{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": ["0"],
        "model": {
          "type": "minecraft:model",
          "model": "manosaba_item:item/anan_book_alt_closed"
        }
      },
      {
        "when": ["1"],
        "model": {
          "type": "minecraft:model",
          "model": "manosaba_item:item/anan_book_alt_open"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "manosaba_item:item/anan_book_alt_closed"
    }
  }
}
